# Copy this file to `.env` (and load it with python-dotenv, or export these
# as real environment variables) before running the Docker services.

DB_HOST=mysql
DB_PORT=3306
DB_USER=elt_user
DB_PASSWORD=strong_elt_password

MYSQL_ROOT_PASSWORD=strong_root_password
MYSQL_DATABASE=bronze_db
MYSQL_USER=elt_user
MYSQL_PASSWORD=strong_elt_password

BRONZE_DB=bronze_db
SILVER_DB=silver_db
GOLD_DB=gold_db

# Path to the pipeline's pipeline.log file, used by the Pipeline Monitoring page.
PIPELINE_LOG_PATH=../data_engineering_project/data/logs/pipeline.log
