# Copy this file to `.env` (and load it with python-dotenv, or export these
# as real environment variables) before running the dashboard.

DB_HOST=localhost
DB_PORT=3306
DB_USER=your_user
DB_PASSWORD=your_password

BRONZE_DB=bronze_db
SILVER_DB=silver_db
